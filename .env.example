# ─── Banco de dados (Railway > MySQL > Variables) ────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=autogestor_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Docker local via autogestor-infra) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Mercado Pago (pegar em mercadopago.com.br/developers) ───────────────────
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# ─── Resend (e-mail transacional — resend.com) ───────────────────────────────
RESEND_API_KEY=

# ─── Firebase Cloud Messaging (notificações push) ────────────────────────────
FCM_SERVER_KEY=

# ─── Consultas SP (Multas, IPVA, Licenciamento) ──────────────────────────────
CONSULTA_PROVIDER=mock
CONSULTA_API_KEY=

# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
