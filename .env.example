# ─── Banco de dados (Railway > MySQL > Variables) ────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=autogestor_db
# 'true' para exigir TLS na conexão com o MySQL. Confirmar no dashboard do
# Railway se a instância gerenciada expõe/exige TLS antes de ligar em produção.
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Docker local via autogestor-infra) ────────────────────────────────
# A senha é a mesma REDIS_PASSWORD configurada no .env do autogestor-infra —
# sem ela a conexão falha, já que o docker-compose agora exige auth no Redis.
REDIS_URL=redis://:senha-aqui@localhost:6379

# ─── Mercado Pago (pegar em mercadopago.com.br/developers) ───────────────────
# Access token: "Suas integrações" > sua aplicação > credenciais de teste/produção.
MERCADO_PAGO_ACCESS_TOKEN=
# Chave secreta de assinatura: "Suas integrações" > sua aplicação > Webhooks >
# "Configurar notificações" — só aparece depois de cadastrar a notification_url.
# Sem isso, POST /api/v1/webhooks/mercadopago rejeita toda notificação com 503.
MERCADO_PAGO_WEBHOOK_SECRET=
# APP_URL precisa ser publicamente alcançável em HTTPS para o Mercado Pago
# conseguir entregar o webhook — localhost não funciona; use um túnel (ngrok etc.)
# em dev ou o domínio real da API em produção.

# ─── Resend (e-mail transacional — resend.com) ───────────────────────────────
# Sem RESEND_API_KEY, o reset de senha cai no fallback de dev (token só no console.log).
RESEND_API_KEY=
# Precisa ser um domínio verificado na Resend em produção; onboarding@resend.dev
# funciona sem verificação, mas só entrega pro próprio email da conta Resend.
RESEND_FROM_EMAIL=AutoGestor <onboarding@resend.dev>

# ─── Firebase Cloud Messaging (notificações push) ────────────────────────────
# A "server key" (FCM_SERVER_KEY) foi a API legada do Google — desligada em jul/2024,
# não existe mais. O caminho atual é HTTP v1 via conta de serviço do Firebase:
# console.firebase.google.com > Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada" (baixa um .json). Cole o CONTEÚDO do arquivo aqui
# como uma linha só (sem quebras). Sem isso, notificações push só caem no
# fallback de notificação in-app (Central de Notificações) — nada quebra, só
# não manda push de verdade. Também precisa de um app Firebase configurado no
# mobile (não existe ainda) pra `users.fcm_token` ser preenchido de verdade.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Consultas SP (Multas, IPVA, Licenciamento) ──────────────────────────────
# 'mock' usa dados fictícios determinísticos (MockProvider) — bom pra
# desenvolver sem contratar nada ainda. Provedores reais possíveis (nenhum
# contratado ainda): Integrador SP.GOV.BR, SERPRO/SENATRAN, Infosimples — ver
# Novo guia.docx seção 24. Trocar exige só implementar IConsultaProvider e
# registrar em src/services/consulta/index.ts, sem tocar em controller/rota.
CONSULTA_PROVIDER=mock
CONSULTA_API_KEY=

# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URLs do autogestor-admin (separadas por vírgula, sem espaço). O app mobile não
# roda em navegador e não precisa entrar nesta lista.
ALLOWED_ORIGINS=http://localhost:5173
